# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file to Git.

# The public URL of your production site (no trailing slash).
# Used for canonical URLs, sitemap, and RSS. Must match your Hostinger domain.
PUBLIC_SITE_URL=https://deli-dailyupdatesworld.com

# Optional analytics (leave empty to disable).
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA_ID=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX
PUBLIC_GTM_ID=

# Google Site Verification meta token (optional, for Search Console).
PUBLIC_GOOGLE_SITE_VERIFICATION=
