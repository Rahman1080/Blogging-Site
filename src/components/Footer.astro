---
import { siteConfig, footerLinks } from "../data/site";
import NewsletterForm from "./NewsletterForm.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer no-print">
  <div class="container">
    <NewsletterForm />

    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="30" height="30" rx="9" fill="#0e766c" />
            <path d="M8 16.5l5 5 11-11" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{siteConfig.name}</span>
        </a>
        <p>{siteConfig.description}</p>
        <div class="footer-social">
          {siteConfig.social.twitter && (
            <a href={siteConfig.social.twitter} rel="noopener" aria-label="Twitter / X">Twitter</a>
          )}
          {siteConfig.social.facebook && (
            <a href={siteConfig.social.facebook} rel="noopener" aria-label="Facebook">Facebook</a>
          )}
          {siteConfig.social.linkedin && (
            <a href={siteConfig.social.linkedin} rel="noopener" aria-label="LinkedIn">LinkedIn</a>
          )}
        </div>
      </div>

      <nav class="footer-col" aria-label="Explore">
        <h3>Explore</h3>
        <ul>
          {footerLinks.explore.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Company">
        <h3>Company</h3>
        <ul>
          {footerLinks.company.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Popular topics">
        <h3>Popular Topics</h3>
        <ul>
          {footerLinks.topics.slice(0, 8).map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
          <li><a href="/categories">All categories →</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>© {year} {siteConfig.legalName}. All rights reserved.</p>
      <p class="footer-note">
        This site participates in affiliate programs. We may earn a small commission
        from qualifying purchases at no extra cost to you. <a href="/disclaimer">Learn more</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #d8d4cc;
    margin-top: clamp(3rem, 8vw, 5.5rem);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-block: 2.5rem;
  }

  .footer-brand p {
    margin-top: 0.9rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #a8a49b;
    max-width: 30ch;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
  }

  .footer-col h3 {
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-col a {
    color: #c9c4ba;
    text-decoration: none;
    font-size: 0.93rem;
  }

  .footer-col a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
    margin-top: 1.1rem;
  }

  .footer-social a {
    color: #a8a49b;
    text-decoration: none;
    font-size: 0.88rem;
  }

  .footer-social a:hover {
    color: #fff;
  }

  .footer-bottom {
    border-top: 1px solid #3a3733;
    padding-block: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #8f8a81;
  }

  .footer-bottom a {
    color: #c9c4ba;
  }

  .footer-note {
    max-width: 62ch;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
