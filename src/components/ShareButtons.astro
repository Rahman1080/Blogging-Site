interface Props {
  title: string;
  url: string;
  /** Short description used where platforms support it. */
  description?: string;
  /** Absolute image URL used where platforms support it (e.g. Pinterest). */
  image?: string;
  tags?: string[];
  /** icon-only variant for the sidebar. */
  compact?: boolean;
}

const { title, url, description = "", image = "", tags = [], compact = false } = Astro.props;
