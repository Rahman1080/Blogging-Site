---

<aside class={`share no-print ${compact ? "share--compact" : ""}`} aria-label="Share this article">
  <span class="share__label">Share this guide</span>
  <div class="share__links">
    {
      platforms.map((p) => (
        <a
          class={`share__link share__link--${p.mod}`}
          style={`--brand:${p.brand}`}
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Share on ${p.name}`}
          title={`Share on ${p.name}`}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d={p.svg} />
          </svg>
          {!compact && <span class="share__name">{p.name}</span>}
        </a>
      ))
    }
    <button
      class="share__link share__link--copylink"
      type="button"
      data-copy-link={url}
      aria-label="Copy link to this article"
      title="Copy link"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      {!compact && <span class="share__name" data-copy-label>Copy Link</span>}
    </button>
  </div>
</aside>

<script>
  document.querySelectorAll("[data-copy-link]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = btn.getAttribute("data-copy-link");
      if (!url) return;
      let ok = false;
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(url);
          ok = true;
        } catch {
          ok = false;
        }
      }
      const label = btn.querySelector("[data-copy-label]");
      if (label) {
        const original = label.textContent || "";
        label.textContent = ok ? "Copied!" : "Copy failed";
        setTimeout(() => {
          label.textContent = original;
        }, 2000);
      } else if (ok) {
        btn.setAttribute("title", "Copied!");
        setTimeout(() => btn.setAttribute("title", "Copy link"), 2000);
      }
    });
  });
</script>

<style>
  .share {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .share__label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .share__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .share__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .share__link:hover {
    border-color: var(--brand, var(--accent));
    color: var(--brand, var(--accent-strong));
    background: color-mix(in srgb, var(--brand, var(--accent)) 8%, transparent);
  }

  .share__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .share--compact .share__link {
    width: 36px;
    height: 36px;
    padding: 0;
  }

  .share--compact .share__label {
    margin-top: 0.25rem;
  }

  @media (max-width: 480px) {
    .share__name {
      display: none;
    }
    .share__link {
      padding: 0.45rem;
    }
  }
</style>
