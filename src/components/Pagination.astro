---
interface Props {
  current: number;
  totalPages: number;
  basePath: string;
}

const { current, totalPages, basePath } = Astro.props;

function pageUrl(page: number): string {
  if (page === 1) return basePath;
  return `${basePath.replace(/\/$/, "")}/page/${page}/`;
}

const pages: (number | "...")[] = [];
for (let p = 1; p <= totalPages; p++) {
  if (p === 1 || p === totalPages || Math.abs(p - current) <= 1) {
    pages.push(p);
  } else if (pages[pages.length - 1] !== "...") {
    pages.push("...");
  }
}
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      <a
        class={`page-link ${current === 1 ? "disabled" : ""}`}
        href={pageUrl(Math.max(1, current - 1))}
        aria-disabled={current === 1}
        rel={current === 1 ? undefined : "prev"}
      >
        ← Newer
      </a>
      <ul class="pages">
        {
          pages.map((p) =>
            p === "..." ? (
              <li class="ellipsis" aria-hidden="true">…</li>
            ) : (
              <li>
                <a
                  class={`page-link ${p === current ? "active" : ""}`}
                  href={pageUrl(p)}
                  aria-current={p === current ? "page" : undefined}
                >
                  {p}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a
        class={`page-link ${current === totalPages ? "disabled" : ""}`}
        href={pageUrl(Math.min(totalPages, current + 1))}
        aria-disabled={current === totalPages}
        rel={current === totalPages ? undefined : "next"}
      >
        Older →
      </a>
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .pages {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.35rem;
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-soft);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .page-link:hover:not(.disabled) {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .page-link.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .page-link.disabled {
    opacity: 0.45;
    pointer-events: none;
  }

  .ellipsis {
    display: inline-flex;
    align-items: center;
    color: var(--ink-muted);
    padding: 0 0.25rem;
  }
</style>
