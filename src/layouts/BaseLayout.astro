---
import { siteConfig } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteUrl } from "../lib/seo";
import { escapeHtml } from "../lib/utils";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Full canonical URL. Defaults to the current page URL. */
  canonical?: string;
  /** Social share image (absolute URL). */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Comma-separated or array of meta keywords. Omitted if empty. */
  keywords?: string[] | string;
  /** OG article:tag values (rendered only when ogType is article). */
  ogTags?: string[];
  /** OG article:section value. */
  ogSection?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** Array of JSON-LD objects to inject. */
  jsonLd?: object[];
  /** Body class additions. */
  bodyClass?: string;
}

const {
  title,
  description = siteConfig.description,
  canonical,
  ogImage,
  ogImageAlt,
  ogType = "website",
  keywords,
  ogTags = [],
  ogSection,
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
  bodyClass,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteConfig.name}` : `${siteConfig.name} — Evergreen Guides, How-Tos & Everyday Answers`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteConfig.url).href;
const robots = noindex || siteConfig.build.noindex
  ? "noindex, nofollow"
  : "index, follow";
const ogImageUrl = ogImage || siteUrl("/og-default.png");
const metaKeywords = Array.isArray(keywords) ? keywords : keywords?.split(",").map((k) => k.trim()).filter(Boolean);
const ogPageTitle = title || siteConfig.name;

const { gaId, gtmId, siteVerification } = siteConfig.analytics;
const ldJson = jsonLd.map((o) => JSON.stringify(o));
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={escapeHtml(description)} />
    {metaKeywords && metaKeywords.length > 0 && (
      <meta name="keywords" content={escapeHtml([...new Set(metaKeywords)].join(", "))} />
    )}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <meta name="generator" content={Astro.generator} />

    {siteVerification && (
      <meta name="google-site-verification" content={siteVerification} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={escapeHtml(ogPageTitle)} />
    <meta property="og:description" content={escapeHtml(description)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={escapeHtml(ogImageAlt || ogPageTitle)} />
    <meta property="og:locale" content={siteConfig.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogTags.map((t) => <meta property="article:tag" content={escapeHtml(t)} />)}
    {ogSection && <meta property="article:section" content={escapeHtml(ogSection)} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={escapeHtml(ogPageTitle)} />
    <meta name="twitter:description" content={escapeHtml(description)} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={escapeHtml(ogImageAlt || ogPageTitle)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />

    {ldJson.map((ld) => <script is:inline type="application/ld+json" set:html={ld} />)}

    {gtmId && (
      <script is:inline>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',{gtmId});
      </script>
    )}
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    {gaId && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
    )}
    {gaId && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{gaId}');
      </script>
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
