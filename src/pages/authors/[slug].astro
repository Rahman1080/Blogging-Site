---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getAllArticles } from "@/lib/content";
import { getAuthorBySlug, slugify } from "@/data/authors";
import { siteUrl } from "@/lib/seo";

export async function getStaticPaths() {
  const articles = await getAllArticles();
  const names = [...new Set(articles.map((a) => a.data.author))];
  return names.map((name) => ({
    params: { slug: slugify(name) },
    props: { authorName: name },
  }));
}

const { authorName } = Astro.props;
const author = getAuthorBySlug(slugify(authorName));
const allArticles = await getAllArticles();
const articles = allArticles.filter((a) => a.data.author === authorName);
const pageUrl = `/authors/${slugify(authorName)}`;

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Authors", url: "/authors" },
  { name: authorName, url: pageUrl },
];

const authorSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: authorName,
    url: siteUrl(pageUrl),
    worksFor: {
      "@type": "Organization",
      name: "Info 24/7",
    },
  },
};
---

<BaseLayout
  title={`${authorName} — Info 24/7`}
  description={author?.bio || `Articles written by ${authorName} on Info 24/7.`}
  jsonLd={[authorSchema]}
>
  <div class="container page">
    <Breadcrumbs items={crumbs} />

    <header class="author">
      <div class="author__avatar" aria-hidden="true">
        {author?.image ? (
          <img src={author.image} alt="" loading="lazy" />
        ) : (
          <span>{authorName.slice(0, 2).toUpperCase()}</span>
        )}
      </div>
      <div>
        <h1 class="author__name">{authorName}</h1>
        <p class="author__role">Writer on Info 24/7</p>
        {author?.bio && <p class="author__bio">{author.bio}</p>}
        {author?.social?.length && (
          <ul class="author__social">
            {author.social.map((s) => (
              <li>
                <a href={s.url} rel="noopener noreferrer" target="_blank">{s.label}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <section class="section">
      <h2 class="section__title">Articles by {authorName}</h2>
      {articles.length > 0 ? (
        <div class="grid">
          {articles.map((entry) => <ArticleCard article={entry} />)}
        </div>
      ) : (
        <p>No published articles yet.</p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .author {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2rem;
  }

  .author__avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--accent-strong);
    flex-shrink: 0;
    overflow: hidden;
  }

  .author__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .author__name {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin-bottom: 0.25rem;
  }

  .author__role {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin-bottom: 0.75rem;
  }

  .author__bio {
    color: var(--ink-soft);
    max-width: 65ch;
  }

  .author__social {
    list-style: none;
    display: flex;
    gap: 0.75rem;
    padding: 0;
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
  }
</style>
