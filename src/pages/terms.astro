---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { siteConfig } from "../data/site";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Terms", url: "/terms" },
];

const lastUpdated = "2026-08-22";
---

<BaseLayout
  title="Terms of Use"
  description="The terms governing your use of {siteConfig.name}."
>
  <PageLayout title="Terms of Use" breadcrumbs={crumbs} updatedDate={lastUpdated}>
    <p>Last updated: {lastUpdated}</p>

    <p>
      These Terms of Use (“Terms”) govern your use of {siteConfig.name}. By accessing or using the
      site, you agree to these Terms. If you do not agree, please do not use the site.
    </p>

    <h2>1. Use of the site</h2>
    <p>
      The site provides general information, guides, tutorials, and opinions for educational
      purposes. You may browse content for personal, non-commercial use. You may not copy,
      republish, or resell content without our written permission.
    </p>

    <h2>2. No professional advice</h2>
    <p>
      Content is provided “as is” for general information and does not constitute professional,
      legal, financial, medical, or technical advice tailored to your situation. You act on
      instructions at your own risk. Always back up data before following any technical
      procedure.
    </p>

    <h2>3. Intellectual property</h2>
    <p>
      All text, design, logos, and original graphics are owned by {siteConfig.legalName} or used
      with permission. Images sourced from third parties remain the property of their respective
      owners and are used under their applicable licenses or as permitted.
    </p>

    <h2>4. External links and third parties</h2>
    <p>
      We link to third-party websites and services for your convenience. We do not control and are
      not responsible for their content, availability, or practices.
    </p>

    <h2>5. Advertising and affiliate disclosure</h2>
    <p>
      We may display advertising and use affiliate links. If you purchase through an affiliate
      link, we may earn a commission at no extra cost to you. Affiliate and sponsored content is
      always disclosed.
    </p>

    <h2>6. Acceptable use</h2>
    <p>You agree not to:</p>
    <ul>
      <li>Attempt to disrupt, overload, or gain unauthorized access to the site or its hosting;</li>
      <li>Scrape or harvest content at scale without permission;</li>
      <li>Use the site for unlawful purposes.</li>
    </ul>

    <h2>7. Limitation of liability</h2>
    <p>
      To the maximum extent permitted by law, {siteConfig.legalName} shall not be liable for any
      indirect, incidental, or consequential damages arising from your use of, or inability to
      use, the site or its content.
    </p>

    <h2>8. Changes</h2>
    <p>
      We may revise these Terms at any time. Continued use after changes are posted means you
      accept the revised Terms.
    </p>

    <h2>9. Contact</h2>
    <p>
      Questions about these Terms: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
    </p>
  </PageLayout>
</BaseLayout>
