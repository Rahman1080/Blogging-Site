---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { contentIdeas, getIdeaCount, opportunityLabel } from "@/data/content-ideas";

const crumbs = [{ name: "Home", url: "/" }, { name: "Content Ideas", url: "/content-ideas" }];
const STRENGTH_LABEL = { high: "High", medium: "Medium", low: "Low" } as const;
const strengthClass = (s: string) => `idea-signal__strength idea-signal__strength--${s}`;
const scoreClass = (s: number) => {
  if (s >= 70) return "idea-score idea-score--strong";
  if (s >= 50) return "idea-score idea-score--moderate";
  return "idea-score idea-score--exploratory";
};
---

<BaseLayout
  title="Content Ideas Dashboard — Info 24/7"
  description="Internal planning dashboard of content opportunities for Info 24/7."
  noindex
>
  <div class="container page">
    <Breadcrumbs items={crumbs} />

    <header class="page-hero">
      <h1>Content Ideas Dashboard</h1>
      <p class="lede">
        An internal planning tool — {getIdeaCount()} ideas across five buckets. Ideas are based on
        observed signals (search demand, trends, forum activity, product releases), but nothing here
        is a ranking or traffic promise. Research each topic before writing.
      </p>
    </header>

    {
      contentIdeas.map((section) => (
        <section class="idea-section" id={section.id}>
          <h2>{section.label}</h2>
          <p class="idea-section__desc">{section.description}</p>

          <div class="idea-card-list">
            {section.ideas.map((idea) => (
              <article class="idea-card">
                <div class="idea-card__head">
                  <h3>{idea.topic}</h3>
                  <span class="idea-card__cat">{idea.category}</span>
                </div>
                <div class="idea-card__topline">
                  <span class={scoreClass(idea.score)} title="Honest opportunity estimate, not a promise">
                    {idea.score} <small>/{opportunityLabel(idea.score)}</small>
                  </span>
                  {idea.status === "published" && idea.article && (
                    <span class="idea-card__published">
                      <a href={`/articles/${idea.article}`}>Published</a>
                    </span>
                  )}
                </div>
                <p class="idea-card__why">{idea.why}</p>
                {idea.searchQuestions?.length ? (
                  <div class="idea-card__block">
                    <h4>Search questions</h4>
                    <ul class="idea-card__list">
                      {idea.searchQuestions.map((q) => <li>{q}</li>)}
                    </ul>
                  </div>
                ) : null}
                {idea.gap && (
                  <p class="idea-card__gap">
                    <strong>Gap:</strong> {idea.gap}
                  </p>
                )}
                {idea.signals?.length ? (
                  <div class="idea-card__block">
                    <h4>Signals</h4>
                    <ul class="idea-card__signals">
                      {idea.signals.map((s) => (
                        <li>
                          <span class={strengthClass(s.strength)}>{STRENGTH_LABEL[s.strength]}</span>
                          <strong>{s.label}</strong>
                          <span>{s.note}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : null}
                {idea.intent && (
                  <p class="idea-card__meta">
                    <strong>Intent:</strong> {idea.intent}
                  </p>
                )}
                {idea.relatedKeywords?.length ? (
                  <p class="idea-card__meta">
                    <strong>Related keywords:</strong> {idea.relatedKeywords.join(" · ")}
                  </p>
                ) : null}
                {idea.longTail?.length ? (
                  <p class="idea-card__meta">
                    <strong>Long-tail:</strong> {idea.longTail.join(" · ")}
                  </p>
                ) : null}
                {idea.relatedQuestions?.length ? (
                  <p class="idea-card__meta">
                    <strong>Related questions:</strong> {idea.relatedQuestions.join(" · ")}
                  </p>
                ) : null}
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <p class="note">
      Tip: after publishing or refreshing an article, rebuild and run{" "}
      <code>npm run indexnow</code> to ping Bing IndexNow.
    </p>
  </div>
</BaseLayout>

<style>
  .lede {
    color: var(--ink-soft);
    max-width: 75ch;
    margin-bottom: 2.5rem;
  }

  .idea-section {
    margin-bottom: 3rem;
    scroll-margin-top: 6rem;
  }

  .idea-section h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
    margin-bottom: 0.35rem;
  }

  .idea-section__desc {
    color: var(--ink-soft);
    max-width: 70ch;
    margin-bottom: 1.25rem;
  }

  .idea-card-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1rem;
  }

  .idea-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    padding: 1.1rem 1.2rem;
  }

  .idea-card__head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .idea-card__topline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .idea-score {
    font-size: 0.82rem;
    font-weight: 800;
    border-radius: 999px;
    padding: 0.18rem 0.6rem;
    white-space: nowrap;
  }

  .idea-score small {
    font-weight: 600;
    font-size: 0.7rem;
    opacity: 0.85;
  }

  .idea-score--strong {
    color: var(--good-ink, #1a7f37);
    background: var(--good-soft, #dcfce7);
  }

  .idea-score--moderate {
    color: #9a6700;
    background: #fff8c5;
  }

  .idea-score--exploratory {
    color: var(--ink-muted);
    background: var(--surface-2, #f0f0f1);
  }

  .idea-card__published {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--good-ink, #1a7f37);
    background: var(--good-soft, #dcfce7);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    white-space: nowrap;
  }

  .idea-card__published a {
    color: inherit;
  }

  .idea-card h3 {
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .idea-card__block {
    margin-bottom: 0.6rem;
  }

  .idea-card__block h4 {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin: 0 0 0.3rem;
  }

  .idea-card__list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.87rem;
    color: var(--ink-soft);
  }

  .idea-card__list li {
    margin-bottom: 0.15rem;
  }

  .idea-card__gap {
    font-size: 0.88rem;
    color: var(--ink-soft);
    background: var(--accent-soft);
    border-left: 3px solid var(--accent-strong);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.45rem 0.6rem;
    margin-bottom: 0.6rem;
  }

  .idea-card__gap strong {
    color: var(--ink);
  }

  .idea-card__signals {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .idea-card__signals li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
  }

  .idea-card__signals li strong {
    color: var(--ink-soft);
    font-weight: 600;
    white-space: nowrap;
  }

  .idea-signal__strength {
    font-size: 0.68rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.08rem 0.45rem;
    flex: none;
  }

  .idea-signal__strength--high {
    color: var(--good-ink, #1a7f37);
    background: var(--good-soft, #dcfce7);
  }

  .idea-signal__strength--medium {
    color: #9a6700;
    background: #fff8c5;
  }

  .idea-signal__strength--low {
    color: var(--ink-muted);
    background: var(--surface-2, #f0f0f1);
  }

  .idea-card__cat {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-strong);
    background: var(--accent-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .idea-card__why {
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin-bottom: 0.6rem;
  }

  .idea-card__meta {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
  }

  .idea-card__meta strong {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .note {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
</style>
